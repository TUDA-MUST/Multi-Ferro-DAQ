	(text "Calulation for charge Amplifier: \nQ=d33*F, Vo = 2V (max. voltage swing)\nd33 = 500pC/N?,	F=1 or 1000N,	Cs=20pF?,	Rs=100GOhm\nVin = Q/Cs\nCf = -Q/Vo (feedback Capacitor)\nfL = 1/(2pi * Rf * Cf) = (Cutoff Frequency)"
		(exclude_from_sim no)
		(at 48.768 143.51 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "bb8b6143-e835-4479-83a1-117e43e495d3")
	)
	(text "Programming:\n- Set *RESET and *PWDN to High\n- Set SPI Mode (0,1) CPOL=0, CPHA=1\n- (VREF_4V <= 1) Set internal Reference Voltage to 4V\n- (OPAMP_REF <= 1) Set Opamp reference to (AVDD+AVSS) / 2\n\n"
		(exclude_from_sim no)
		(at 186.944 149.098 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
			)
			(justify left)
